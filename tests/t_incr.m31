/* Incremental reparse: after any edit, reusing the old tree must give exactly the tree a
 * parse from scratch gives (every node, hidden ones included), while reading far fewer
 * tokens. Edits come from a fixed pseudo-random sequence (a linear congruential
 * generator), so a failure names the step and repeats. Counts are compared, never times. */

import core.GRV_edit;
import core.GRV_glr;
import core.GRV_grammar;
import core.GRV_lang;
import core.GRV_lexer;
import core.GRV_lr;
import core.GRV_tree;
import io;
import tests.GRV_check;

GRV_check.Check check = GRV_check.Check();

type Random {
    int state;
}

int Random.next(int bound) {
    state = (state * 1103515245 + 12345) % 2147483648;
    return (state / 65536) % bound;
}

Option<GRV_lexer.Lexer> lexer_of(str path) {
    match (io.read(path)) {
        case Err(io.Error failure): {
            return Option<GRV_lexer.Lexer>.None;
        }
        case Ok(str text): {
            match (GRV_grammar.load(text)) {
                case Err(str reason): {
                    return Option<GRV_lexer.Lexer>.None;
                }
                case Ok(GRV_grammar.Grammar grammar): {
                    return Option<GRV_lexer.Lexer>.Some(GRV_lexer.make(GRV_lr.build(GRV_lang.build(grammar))));
                }
            }
        }
    }
}

/* Apply `steps` random edits to `source` and undo each one, comparing the incrementally reparsed tree with a
 * scratch parse after both. When the edit leaves the text with a syntax error the trees may legitimately
 * differ (recovery depends on what was reused); when it does not, and always after the undo, they must be
 * identical. Returns the number of comparisons that failed; `counts` = [tokens read incrementally, tokens
 * read from scratch, nodes reused, edits that broke the syntax, 0]. */
int run(GRV_lexer.Lexer lexer, str source, int seed, int steps, int most_removed, List<str> snippets, List<int> counts) {
    Random random = Random(seed);
    GRV_tree.Tree tree = GRV_glr.parse(lexer, source);
    int mismatches = 0;
    for (int step in 0 .. steps) {
        int start = random.next(source.size() + 1);
        int removed = random.next(most_removed + 1);
        if (start + removed > source.size()) {
            removed = source.size() - start;
        }
        // keep edits on character boundaries
        while (start < source.size() && (source.byte_at(start) & 192) == 128) {
            start = start + 1;
        }
        while (start + removed < source.size() && (source.byte_at(start + removed) & 192) == 128) {
            removed = removed + 1;
        }
        str added = snippets[random.next(snippets.size())];
        str changed = source.substr(0, start) + added + source.substr(start + removed, source.size());
        for (int direction in 0 .. 2) {
            str before = source;
            str after = changed;
            int old_end = start + removed;
            int new_end = start + added.size();
            if (direction == 1) {
                before = changed;
                after = source;
                old_end = start + added.size();
                new_end = start + removed;
            }
            GRV_edit.apply(tree, start, old_end, new_end);
            GRV_glr.Parser parser = GRV_glr.begin(lexer, after, Option<GRV_tree.Tree>.Some(tree));
            parser.has_finished_after(9223372036854775807);
            GRV_glr.Parser fresh = GRV_glr.begin(lexer, after, Option<GRV_tree.Tree>.None);
            fresh.has_finished_after(9223372036854775807);
            bool is_equal = parser.tree.full() == fresh.tree.full() && parser.tree.has_errors() == fresh.tree.has_errors();
            if (fresh.tree.has_errors()) {
                counts[3] = counts[3] + 1;
            } else if (!is_equal) {
                mismatches = mismatches + 1;
                print("mismatch at step " + str(step) + (if_undo(direction)) + ": [" + str(start) + ", " + str(old_end) + ") -> " + str(new_end));
            }
            counts[0] = counts[0] + parser.lexed_tokens;
            counts[1] = counts[1] + fresh.lexed_tokens;
            counts[2] = counts[2] + parser.reused_nodes;
            tree = parser.tree;
        }
    }
    return mismatches;
}

str if_undo(int direction) {
    if (direction == 1) {
        return " (undo)";
    }
    return "";
}

str records(int count) {
    List<str> items = [];
    for (int index in 0 .. count) {
        items.push("  {\"id\": " + str(index) + ", \"name\": \"item " + str(index) + "\", \"tags\": [\"a\", \"b\"], \"ok\": true}");
    }
    return "[\n" + items.join(",\n") + "\n]\n";
}

str functions(int count) {
    str one = "int f(int a) {\n    if (a > 1) {\n        return a * 2;\n    }\n    return a;\n}\n\n";
    return "#include <stdio.h>\n\n" + one.repeat(count);
}

void exercise(GRV_check.Check check, str name, str grammar_path, str source, int seed, List<str> hostile, List<str> benign) {
    match (lexer_of(grammar_path)) {
        case None: {
            check.ok(name + ": load the grammar", false);
        }
        case Some(GRV_lexer.Lexer lexer): {
            // edits that break and mend the syntax: only equality is asked
            List<int> rough = [0, 0, 0, 0, 0];
            check.eq_int(name + ": incremental equals scratch over 80 hostile edits", run(lexer, source, seed, 80, 2, hostile, rough), 0);
            check.ok(name + ": nodes were reused", rough[2] > 0);
            check.ok(name + ": some hostile edits did break the syntax", rough[3] > 0);
            // edits that leave the syntax alone: the incremental parses must read far fewer tokens
            List<int> calm = [0, 0, 0, 0, 0];
            check.eq_int(name + ": incremental equals scratch over 60 benign edits", run(lexer, source, seed + 1, 60, 0, benign, calm), 0);
            check.ok(name + ": benign edits read under a third of the tokens", calm[0] * 3 < calm[1]);
            // the arena keeps old versions; compaction gives them back without changing the tree
            GRV_tree.Tree whole = GRV_glr.parse(lexer, source);
            check.eq_str(name + ": compaction keeps the tree", whole.compact().full(), whole.full());
            check.ok(name + ": and never grows it", whole.compact().arena_size() <= whole.arena_size());
        }
    }
}

exercise(check, "json", "tests/data/json/grammar.json", records(60), 7, ["", " ", "\n", "1", "x", ",", "\"", "[", "]", "{", "}", ":", "true", "\"k\": 1,"], ["", " ", "\n", "1", "22", "0"]);
exercise(check, "c", "tests/data/c/grammar.json", functions(25), 11, ["", " ", "\n", "1", "x", ";", "(", ")", "{", "}", "/* c */", "int x;", "a = b;", "\n#define A 1\n"], ["", " ", "\n", "1", "/* c */", "  "]);

str lua_source(int count) {
    str one = "local function f(a, b)\n  -- a comment\n  local s = [==[ long ]] string ]==]\n  --[[ block\n  comment ]]\n  return a + b, s\nend\n\n";
    return one.repeat(count);
}

exercise(check, "lua", "tests/data/lua/grammar.json", lua_source(20), 21, ["", " ", "\n", "1", "x", "[[", "]]", "--", "--[[", "]==]", "[==[", "end", "(", ")"], ["", " ", "\n", "1", "-- c\n", "  "]);
check.finish();
