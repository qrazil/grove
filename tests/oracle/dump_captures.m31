/* Dump the captures grove's queries give, in the format of dump_captures.lua.
 *
 *   dump_captures GRAMMAR.json QUERY.scm PATH [PATH ...]
 *
 * Output per file: `@@ PATH` then `NAME SROW SCOL EROW ECOL` per capture (names starting with `_` left
 * out), or `!! PATH: why`. */

import core.GRV_glr;
import core.GRV_grammar;
import core.GRV_lang;
import core.GRV_lexer;
import core.GRV_lr;
import core.GRV_query;
import core.GRV_tree;
import io;
import os;

// row of the byte offset `position`, given the start offsets of the lines
int row_of(List<int> starts, int position) {
    int low = 0;
    int high = starts.size() - 1;
    while (low < high) {
        int middle = (low + high + 1) / 2;
        if (starts[middle] <= position) {
            low = middle;
        } else {
            high = middle - 1;
        }
    }
    return low;
}

// byte offset of (row, column), clamped
int offset_of(List<int> starts, int row, int column, int size) {
    int clamped = row;
    if (clamped < 0) {
        clamped = 0;
    }
    if (clamped >= starts.size()) {
        return size;
    }
    return starts[clamped] + column;
}

List<int> line_starts(str text) {
    List<int> starts = [0];
    for (int index in 0 .. text.size()) {
        if (text.byte_at(index) == 10) {
            starts.push(index + 1);
        }
    }
    return starts;
}

str slurp(str path) {
    match (io.read(path)) {
        case Ok(str text): {
            return text;
        }
        case Err(io.Error failure): {
            print("cannot read " + path);
            os.exit(1);
            return "";
        }
    }
}

List<str> argv = os.arguments();
if (argv.size() < 4) {
    print("usage: dump_captures GRAMMAR.json QUERY.scm PATH [PATH ...]");
    os.exit(2);
}
match (GRV_grammar.load(slurp(argv[1]))) {
    case Err(str reason): {
        print(reason);
        os.exit(1);
    }
    case Ok(GRV_grammar.Grammar grammar): {
        GRV_lexer.Lexer lexer = GRV_lexer.make(GRV_lr.build(GRV_lang.build(grammar)));
        GRV_query.Query query = GRV_query.parse(slurp(argv[2]));
        if (query.is_failed) {
            print(query.error_text);
            os.exit(1);
        }
        for (int position in 3 .. argv.size()) {
            match (io.read(argv[position])) {
                case Err(io.Error failure): {
                    print("!! " + argv[position] + ": unreadable");
                }
                case Ok(str source): {
                    GRV_tree.Tree tree = GRV_glr.parse(lexer, source);
                    print("@@ " + argv[position]);
                    if (tree.has_errors()) {
                        print("!! " + argv[position] + ": the tree has errors");
                    } else {
                        List<int> starts = line_starts(source);
                        for (GRV_query.Found one in GRV_query.run(query, tree, source, 0, source.size())) {
                            if (one.name.starts_with("_")) {
                                continue;
                            }
                            int start_row = row_of(starts, one.start);
                            int start_column = one.start - starts[start_row];
                            int stop_row = row_of(starts, one.stop);
                            int stop_column = one.stop - starts[stop_row];
                            if (one.offset.size() == 4) {
                                start_row = start_row + one.offset[0];
                                start_column = start_column + one.offset[1];
                                stop_row = stop_row + one.offset[2];
                                stop_column = stop_column + one.offset[3];
                            }
                            print(one.name + " " + str(start_row) + " " + str(start_column) + " " + str(stop_row) + " " + str(stop_column));
                        }
                    }
                }
            }
        }
    }
}
