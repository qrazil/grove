/* The query oracle: the captures grove's queries give against nvim's, for the fixtures of
 * tests/oracle/fixtures.tsv, with the vendored highlights of tests/data/queries (the dumps in
 * tests/oracle/cap come from tests/oracle/refresh_captures.sh). Compared as sets of
 * `name start-row start-column end-row end-column`. */

import core.GRV_glr;
import core.GRV_grammar;
import core.GRV_lang;
import core.GRV_lexer;
import core.GRV_lr;
import core.GRV_query;
import core.GRV_tree;
import io;
import tests.GRV_check;

GRV_check.Check check = GRV_check.Check();

str read_or_empty(str path) {
    match (io.read(path)) {
        case Ok(str text): {
            return text;
        }
        case Err(io.Error failure): {
            return "";
        }
    }
}

int row_of(List<int> starts, int position) {
    int low = 0;
    int high = starts.size() - 1;
    while (low < high) {
        int middle = (low + high + 1) / 2;
        if (starts[middle] <= position) {
            low = middle;
        } else {
            high = middle - 1;
        }
    }
    return low;
}

/// the sorted, distinct lines grove's captures make, in the format of the dumps
List<str> grove_lines(GRV_query.Query query, GRV_tree.Tree tree, str source) {
    List<int> starts = [0];
    for (int index in 0 .. source.size()) {
        if (source.byte_at(index) == 10) {
            starts.push(index + 1);
        }
    }
    Map<str, bool> seen = {};
    List<str> lines = [];
    for (GRV_query.Found one in GRV_query.run(query, tree, source, 0, source.size())) {
        if (one.name.starts_with("_")) {
            continue;
        }
        int start_row = row_of(starts, one.start);
        int start_column = one.start - starts[start_row];
        int stop_row = row_of(starts, one.stop);
        int stop_column = one.stop - starts[stop_row];
        if (one.offset.size() == 4) {
            start_row = start_row + one.offset[0];
            start_column = start_column + one.offset[1];
            stop_row = stop_row + one.offset[2];
            stop_column = stop_column + one.offset[3];
        }
        str line = one.name + " " + str(start_row) + " " + str(start_column) + " " + str(stop_row) + " " + str(stop_column);
        if (!seen.contains(line)) {
            seen.set(line, true);
            lines.push(line);
        }
    }
    lines.sort();
    return lines;
}

/// the sorted, distinct capture lines of a dump
List<str> dump_lines(str dump) {
    Map<str, bool> seen = {};
    List<str> lines = [];
    for (str line in dump.split("\n")) {
        if (line == "" || line.starts_with("@@")) {
            continue;
        }
        if (!seen.contains(line)) {
            seen.set(line, true);
            lines.push(line);
        }
    }
    lines.sort();
    return lines;
}

Map<str, GRV_lexer.Lexer> lexers = {};
Map<str, GRV_query.Query> queries = {};
for (str row in read_or_empty("tests/oracle/fixtures.tsv").split("\n")) {
    List<str> columns = row.split("\t");
    if (row.starts_with("#") || columns.size() < 2) {
        continue;
    }
    str language = columns[0];
    str path = columns[1];
    if (!lexers.contains(language)) {
        match (GRV_grammar.load(read_or_empty("tests/data/" + language + "/grammar.json"))) {
            case Err(str reason): {
                check.ok("grammar for " + language, false);
                continue;
            }
            case Ok(GRV_grammar.Grammar grammar): {
                lexers.set(language, GRV_lexer.make(GRV_lr.build(GRV_lang.build(grammar))));
                GRV_query.Query loaded = GRV_query.parse(read_or_empty("tests/data/queries/" + language + ".scm"));
                check.ok("queries for " + language + " load: " + loaded.error_text, !loaded.is_failed);
                queries.set(language, loaded);
            }
        }
    }
    match (lexers.get(language)) {
        case None: {
            continue;
        }
        case Some(GRV_lexer.Lexer lexer): {
            match (queries.get(language)) {
                case None: {
                    continue;
                }
                case Some(GRV_query.Query query): {
                    str source = read_or_empty(path);
                    GRV_tree.Tree tree = GRV_glr.parse(lexer, source);
                    str dump = read_or_empty("tests/oracle/cap/" + path.split("/").join("__") + ".cap");
                    if (tree.has_errors()) {
                        check.ok(path + ": the tree has errors", false);
                    } else {
                        check.eq_str(path, grove_lines(query, tree, source).join("\n"), dump_lines(dump).join("\n"));
                    }
                }
            }
        }
    }
}
check.finish();
