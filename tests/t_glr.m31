/* The LR/GLR parser on small grammars (tests/data/mini): precedence and
 * associativity, a reduce/reduce fork settled by dynamic precedence, extras and
 * fields, failure, and that the work grows linearly (a ratio of tree sizes,
 * never a time). */

import core.GRV_glr;
import core.GRV_grammar;
import core.GRV_lang;
import core.GRV_lexer;
import core.GRV_lr;
import core.GRV_tree;
import io;
import tests.GRV_check;

GRV_check.Check check = GRV_check.Check();

Option<GRV_lexer.Lexer> lexer_of(str name) {
    match (io.read("tests/data/mini/" + name + ".json")) {
        case Err(io.Error failure): {
            return Option<GRV_lexer.Lexer>.None;
        }
        case Ok(str text): {
            match (GRV_grammar.load(text)) {
                case Err(str reason): {
                    return Option<GRV_lexer.Lexer>.None;
                }
                case Ok(GRV_grammar.Grammar grammar): {
                    return Option<GRV_lexer.Lexer>.Some(GRV_lexer.make(GRV_lr.build(GRV_lang.build(grammar))));
                }
            }
        }
    }
}

// "(a\t0-1\n  (b\t0-1))" -> "(a (b))": ranges stripped, one line
str shape(str dump) {
    str out = "";
    for (str line in dump.split("\n")) {
        str body = line.trim();
        int closes = 0;
        while (body.ends_with(")")) {
            body = body.substr(0, body.size() - 1);
            closes = closes + 1;
        }
        int tab = body.index_of("\t").or(-1);
        if (tab >= 0) {
            body = body.substr(0, tab);
        }
        if (out != "") {
            out = out + " ";
        }
        out = out + body + ")".repeat(closes);
    }
    return out;
}

str parse_to_shape(str grammar_name, str source) {
    match (lexer_of(grammar_name)) {
        case None: {
            return "cannot load " + grammar_name;
        }
        case Some(GRV_lexer.Lexer lexer): {
            GRV_tree.Tree tree = GRV_glr.parse(lexer, source);
            if (tree.has_errors()) {
                return "errors: " + shape(tree.sexp());
            }
            return shape(tree.sexp());
        }
    }
}

check.eq_str("a number", parse_to_shape("expr", "42"), "(program (number))");
check.eq_str("left associative", parse_to_shape("expr", "1-2-3"), "(program (binary (binary (number) (number)) (number)))");
check.eq_str("higher precedence binds tighter", parse_to_shape("expr", "1-2*3"), "(program (binary (number) (binary (number) (number))))");
check.eq_str("and on the left too", parse_to_shape("expr", "1*2-3"), "(program (binary (binary (number) (number)) (number)))");
check.eq_str("right associative", parse_to_shape("expr", "1^2^3"), "(program (binary (number) (binary (number) (number))))");
check.eq_str("whitespace is an extra", parse_to_shape("expr", " 1 -\n 2 "), "(program (binary (number) (number)))");
check.eq_str("a missing operand leaves an ERROR", parse_to_shape("expr", "1-"), "errors: (ERROR (number))");
check.eq_str("an unknown character is skipped inside an ERROR", parse_to_shape("expr", "1 + 2"), "errors: (program (number) (ERROR))");
check.eq_str("dynamic precedence picks a", parse_to_shape("dyn_a", "x;"), "(program (a))");
check.eq_str("dynamic precedence picks b", parse_to_shape("dyn_b", "x;"), "(program (b))");
check.eq_str("equal dynamic precedence: the tree that sorts first (rule a) wins, as ts_subtree_compare decides", parse_to_shape("dyn_tie", "x;"), "(program (a))");
check.eq_str("fields and a comment extra between children", parse_to_shape("extras", "let a = 1; # one\nlet b = 2;"), "(program (item name: (name) (number)) (comment) (item name: (name) (number)))");
check.eq_str("a comment before the first token", parse_to_shape("extras", "# top\nlet a = 1;"), "(program (comment) (item name: (name) (number)))");

// linear growth: n items and 2n items give trees whose sizes are in a ratio near 2
int nodes_of(str source) {
    match (lexer_of("extras")) {
        case None: {
            return 0;
        }
        case Some(GRV_lexer.Lexer lexer): {
            return GRV_glr.parse(lexer, source).compact().arena_size();
        }
    }
}

str one = "let a = 1;\n";
int small = nodes_of(one.repeat(50));
int large = nodes_of(one.repeat(100));
check.ok("tree size grows linearly with the input", large * 10 >= small * 19 && large * 10 <= small * 21);
check.finish();
